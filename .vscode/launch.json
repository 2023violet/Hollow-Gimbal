{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FalconFOC V2 DAP-Link Debug",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/vscode-arm/falconfoc-v2-at32f415.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "tools/openocd/openocd_daplink.cfg"
      ],
      "serverpath": "C:/Program Files (x86)/OpenOCD_V2.0.6/bin/openocd.exe",
      "searchDir": [
        "${workspaceFolder}"
      ],
      "preLaunchTask": "FalconFOC V2: build ARM image",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "both",
      "svdPath": "${workspaceFolder}/platform/at/at32f415/AT32F415xx_v2.svd",
      "device": "AT32F415KBU7_4",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    }
  ]
}
