{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Themis: Build fw-full-diag-carrier-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "build-fw-full-diag-carrier-debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Themis: Firmware build via run.sh",
      "type": "shell",
      "command": "bash",
      "args": [
        "./run.sh",
        "build"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Themis: Firmware flash via run.sh",
      "type": "shell",
      "command": "bash",
      "args": [
        "./run.sh",
        "flash"
      ],
      "problemMatcher": []
    },
    {
      "label": "Themis: Firmware rebuild via run.sh",
      "type": "shell",
      "command": "bash",
      "args": [
        "./run.sh",
        "rebuild"
      ],
      "problemMatcher": "$gcc"
    }
  ]
}
