#############################################
# Utility command for edit_cache

build applications/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\study\Software\Hollow-Gimbal\build\applications && "C:\Program Files (x86)\cmake\bin\cmake-gui.exe" -SD:\study\Software\Hollow-Gimbal -BD:\study\Software\Hollow-Gimbal\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build applications/edit_cache: phony applications/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build applications/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\study\Software\Hollow-Gimbal\build\applications && "C:\Program Files (x86)\cmake\bin\cmake.exe" --regenerate-during-build -SD:\study\Software\Hollow-Gimbal -BD:\study\Software\Hollow-Gimbal\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build applications/rebuild_cache: phony applications/CMakeFiles/rebuild_cache.util

