# Themis active C/C++ formatter baseline.
# Decision:
# - Keep the repo-active 4-space / function-brace-on-next-line style as the
#   current executable standard.
# - Document stricter alternatives in docs instead of forcing them into the
#   repo before the owned code corpus is ready.

Language: Cpp
BasedOnStyle: LLVM
Standard: Latest
LineEnding: LF

IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 100

# Preprocessor directives.
IndentPPDirectives: None
PPIndentWidth: 0

# Alignment.
AccessModifierOffset: -1

AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false # true
  AcrossComments: true
  AlignCompound: false
  PadOperators: true

AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: true
  AlignCompound: false
  PadOperators: true

AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: true
  AcrossComments: true
  AlignCompound: false
  PadOperators: true

AlignConsecutiveBitFields:
  Enabled: true

AlignArrayOfStructures: None
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignEscapedNewlines: Left
AlignTrailingComments: true

# Braces.
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterExternBlock: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

BreakBeforeBraces: Custom

# Functions and parameters.
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false
BinPackParameters: false
BinPackArguments: false

PenaltyBreakBeforeFirstCallParameter: 30
PenaltyBreakOpenParenthesis: 0
PenaltyReturnTypeOnItsOwnLine: 200

AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: All

# Control statements.
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# Operators and spacing.
BreakBeforeBinaryOperators: None

BreakBeforeTernaryOperators: true
BreakConstructorInitializers: AfterColon
BreakInheritanceList: AfterColon
BreakStringLiterals: true

SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeCtorInitializerColon: true
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: true

# Pointer/reference alignment.
PointerAlignment: Right
ReferenceAlignment: Right
DerivePointerAlignment: false

# Comments.
ReflowComments: false
SpacesBeforeTrailingComments: 1
CommentPragmas: "^ IWYU pragma:"

# Empty lines.
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
KeepEmptyLinesAtEOF: true

# Includes.
SortIncludes: Never
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^".*"'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2

# Misc.
AlwaysBreakTemplateDeclarations: MultiLine
AlwaysBreakAfterDefinitionReturnType: None
AlwaysBreakAfterReturnType: None

BreakArrays: false
Cpp11BracedListStyle: true

FixNamespaceComments: true
NamespaceIndentation: None

InsertBraces: false
InsertNewlineAtEOF: true

# Macros.
WhitespaceSensitiveMacros:
  - BOOST_PP_STRINGIZE
  - CF_SWIFT_NAME
  - NS_SWIFT_NAME
  - PP_STRINGIZE
  - STRINGIZE

ForEachMacros:
  - foreach
  - Q_FOREACH
  - BOOST_FOREACH
