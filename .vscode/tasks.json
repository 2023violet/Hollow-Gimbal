{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FalconFOC V2: configure ARM image",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "firmware/at32f415",
        "-B", "build/vscode-arm",
        "-G", "Ninja",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/tools/cmake/arm-gcc-toolchain.cmake",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "problemMatcher": []
    },
    {
      "label": "FalconFOC V2: build ARM image",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/vscode-arm"],
      "dependsOn": "FalconFOC V2: configure ARM image",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
