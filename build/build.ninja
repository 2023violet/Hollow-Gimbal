  CONFIG = Debug
  LANGUAGE_COMPILE_FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=soft -mthumb -fdata-sections -ffunction-sections -Wall -g
  OBJECT_DIR = applications\CMakeFiles\applications.dir
  POST_BUILD = cd .
