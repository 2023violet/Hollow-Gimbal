{
  "cmake.useCMakePresets": "never",
  "cmake.sourceDirectory": "${workspaceFolder}/firmware/at32f415",
  "cmake.buildDirectory": "${workspaceFolder}/build/vscode-arm",
  "cmake.generator": "Ninja",
  "cmake.configureSettings": {
    "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/tools/cmake/arm-gcc-toolchain.cmake",
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
  },
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "files.associations": {
    "CMakeLists.txt": "cmake"
  },
  "[cmake]": {
    "editor.defaultFormatter": "twxs.cmake",
    "editor.formatOnSave": true
  }
}
